# Docker 部署环境变量（复制为 .env 后修改，docker compose 会自动读取）

# Web 暴露端口（浏览器访问 http://<服务器IP>:3010）
WEB_PORT=3010

# 镜像来源（默认拉取 GitHub Actions 推送到 GHCR 的镜像）
# 改了 GitHub 用户名 / 用别的仓库时，在这里覆盖
CARDLINE_REGISTRY=ghcr.io/zhoudashuaibi
# latest 跟随默认分支最新构建；生产环境建议固定成 sha-xxxxxxx 或版本号
CARDLINE_TAG=latest

# 后台 JWT 密钥 —— 生产环境必须改成随机长字符串
JWT_SECRET=cardline-please-change-this-secret
JWT_EXPIRES_IN=7d

# 首次启动自动创建的后台账号（仅在用户表为空时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 邮箱取件并发与单账号取件邮件数
PICKUP_CONCURRENCY=4
PICKUP_TIMEOUT_MS=30000
PICKUP_MAX_MESSAGES=30

# 卡密前缀
CARD_PREFIX=CARD

# 时区
TZ=Asia/Shanghai
