# 后端配置示例（复制为 .env 后按需修改）
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# SQLite 数据库文件
# 本地开发：file:./cardline.db （相对 apps/server/prisma 目录）
# Docker  ：file:/data/cardline.db
DATABASE_URL="file:./cardline.db"

# 后台 JWT 密钥（生产环境务必修改）
JWT_SECRET=cardline-dev-secret-change-me
JWT_EXPIRES_IN=7d

# 首次启动自动创建的后台账号（仅在用户表为空时生效）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 允许跨域的前端地址（逗号分隔，* 表示全部）
CORS_ORIGIN=*

# 邮箱取件
PICKUP_CONCURRENCY=4
PICKUP_TIMEOUT_MS=30000
PICKUP_MAX_MESSAGES=30

# 卡密默认前缀
CARD_PREFIX=CARD
