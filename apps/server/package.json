{
  "name": "@cardline/server",
  "version": "1.0.0",
  "private": true,
  "description": "卡密兑换系统后端 (NestJS + Prisma + SQLite)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:bootstrap": "node scripts/bootstrap-db.js",
    "db:push": "prisma db push && prisma generate",
    "db:studio": "prisma studio",
    "make-samples": "node scripts/make-samples.js",
    "test:convert": "node --test test/*.test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "page-check": "node scripts/page-check.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
